{
  "version": 1,
  "note": "Seeded-fault corpus. Edits are exact { path, find, replace } (each find occurs once). line = 1-based source line of the defect (anchor). Tested by test/fix/fix-corpus.test.js.",
  "sites": [
    {
      "id": "orchard-nav",
      "dir": "sites/orchard-nav",
      "routes": [
        "/"
      ],
      "defects": [
        {
          "id": "orchard-button-name",
          "rule": "button-name",
          "class": "fixable",
          "file": "src/partials/header.liquid",
          "line": 3,
          "anchor": "<button class=\"menu-btn\"",
          "scope": {
            "file": "src/partials/header.liquid",
            "startLine": 2,
            "endLine": 4
          },
          "designLock": true,
          "element": {
            "selector": "#menu-btn",
            "html": "<button class=\"menu-btn\" id=\"menu-btn\" type=\"button\" aria-controls=\"primary-nav\" aria-expanded=\"false\">"
          },
          "evidence": [
            "Element has no accessible name: its only text is inside aria-hidden"
          ],
          "expectedFix": {
            "edits": [
              {
                "path": "src/partials/header.liquid",
                "find": "aria-expanded=\"false\"><span aria-hidden",
                "replace": "aria-expanded=\"false\" aria-label=\"Menu\"><span aria-hidden"
              }
            ]
          },
          "recipe": true
        },
        {
          "id": "orchard-nav-main",
          "rule": "landmark-unique",
          "class": "not_scannable",
          "file": "src/partials/header.liquid",
          "line": 4,
          "anchor": "<nav id=\"primary-nav\"",
          "scope": {
            "file": "src/partials/header.liquid",
            "startLine": 3,
            "endLine": 5
          },
          "designLock": true,
          "element": {
            "selector": "#primary-nav",
            "html": "<nav id=\"primary-nav\" class=\"site-nav\" hidden>"
          },
          "evidence": [
            "Landmarks must have a unique role or role/label/title combination: two unlabelled navigation landmarks"
          ],
          "expectedFix": {
            "edits": [
              {
                "path": "src/partials/header.liquid",
                "find": "<nav id=\"primary-nav\" class=\"site-nav\" hidden>",
                "replace": "<nav id=\"primary-nav\" class=\"site-nav\" hidden aria-label=\"Main\">"
              }
            ]
          },
          "recipe": true,
          "note": "the nav is `hidden` in the initial DOM, so no engine sees two unlabeled navigation landmarks"
        },
        {
          "id": "orchard-nav-footer",
          "rule": "landmark-unique",
          "class": "not_scannable",
          "file": "src/partials/footer.liquid",
          "line": 2,
          "anchor": "<nav id=\"footer-nav\"",
          "scope": {
            "file": "src/partials/footer.liquid",
            "startLine": 1,
            "endLine": 3
          },
          "designLock": true,
          "element": {
            "selector": "#footer-nav",
            "html": "<nav id=\"footer-nav\" class=\"footer-nav\">"
          },
          "evidence": [
            "Landmarks must have a unique role or role/label/title combination: two unlabelled navigation landmarks"
          ],
          "expectedFix": {
            "edits": [
              {
                "path": "src/partials/footer.liquid",
                "find": "<nav id=\"footer-nav\" class=\"footer-nav\">",
                "replace": "<nav id=\"footer-nav\" class=\"footer-nav\" aria-label=\"Footer\">"
              }
            ]
          },
          "recipe": true,
          "note": "the primary nav is `hidden` in the initial DOM, so no engine sees two unlabeled navigation landmarks"
        },
        {
          "id": "orchard-disclosure",
          "rule": "disclosure-missing-aria-expanded",
          "class": "not_scannable",
          "file": "src/partials/header.liquid",
          "line": 6,
          "anchor": "<button class=\"disc-btn\"",
          "scope": {
            "file": "src/partials/header.liquid",
            "startLine": 5,
            "endLine": 7
          },
          "designLock": true,
          "element": {
            "selector": ".disc-btn",
            "html": "<button class=\"disc-btn\" type=\"button\" aria-controls=\"products-panel\">"
          },
          "evidence": [
            "Control opens a panel but does not expose aria-expanded; the toggle script already updates it"
          ],
          "expectedFix": {
            "edits": [
              {
                "path": "src/partials/header.liquid",
                "find": "aria-controls=\"products-panel\">Products",
                "replace": "aria-controls=\"products-panel\" aria-expanded=\"false\">Products"
              }
            ]
          },
          "recipe": true,
          "note": "the disclosure button sits inside the nav that is `hidden` in the initial DOM, so the scanner never sees it"
        }
      ],
      "wrongFixes": [
        {
          "id": "orchard-remove-button",
          "defect": "orchard-button-name",
          "kind": "remove-element",
          "why": "button-name \"fixed\" by deleting the menu button",
          "expect": [
            "G3"
          ],
          "edits": [
            {
              "path": "src/partials/header.liquid",
              "find": "  <button class=\"menu-btn\" id=\"menu-btn\" type=\"button\" aria-controls=\"primary-nav\" aria-expanded=\"false\"><span aria-hidden=\"true\">Menu</span><span class=\"menu-icon\"></span></button>\n",
              "replace": ""
            }
          ]
        },
        {
          "id": "orchard-aria-hidden-button",
          "defect": "orchard-button-name",
          "kind": "aria-hidden-focusable",
          "why": "the focusable menu button is hidden from assistive technology instead of named",
          "expect": [
            "G1"
          ],
          "needsScanner": true,
          "edits": [
            {
              "path": "src/partials/header.liquid",
              "find": "aria-expanded=\"false\"><span aria-hidden",
              "replace": "aria-expanded=\"false\" aria-hidden=\"true\"><span aria-hidden"
            }
          ]
        },
        {
          "id": "orchard-rename-id",
          "defect": "orchard-button-name",
          "kind": "rename-script-id",
          "why": "label added but the id the toggle script looks up is renamed (script throws on load)",
          "expect": [
            "G6"
          ],
          "edits": [
            {
              "path": "src/partials/header.liquid",
              "find": "id=\"menu-btn\" type=\"button\" aria-controls=\"primary-nav\" aria-expanded=\"false\"><span aria-hidden",
              "replace": "id=\"menu-button\" type=\"button\" aria-controls=\"primary-nav\" aria-expanded=\"false\" aria-label=\"Menu\"><span aria-hidden"
            }
          ]
        },
        {
          "id": "orchard-heavy-script",
          "defect": "orchard-button-name",
          "kind": "heavy-script",
          "why": "correct aria-label plus an inline script that blocks the main thread for 800 ms",
          "expect": [
            "G7"
          ],
          "needsPerf": true,
          "edits": [
            {
              "path": "src/partials/header.liquid",
              "find": "aria-expanded=\"false\"><span aria-hidden",
              "replace": "aria-expanded=\"false\" aria-label=\"Menu\"><script>for (var t = Date.now(); Date.now() - t < 800;) {}</script><span aria-hidden"
            }
          ]
        }
      ]
    },
