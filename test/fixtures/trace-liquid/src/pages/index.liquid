{% layout "layout" %}
{% block content %}
<main id="main">
<section class="hero">
  <h1 class="hero-title">Build your career at Acme</h1>
  <img class="hero-image" src="/hero.jpg" width="1200" height="480">
  <a class="hero-cta" href="/jobs">Search jobs</a>
</section>
<section class="job-cards">
  <article class="job-card">
    <h3 class="card-title">Store Associate</h3>
    <a class="card-link" href="/jobs">Explore store roles</a>
  </article>
  <article class="job-card">
    <h3 class="card-title">Delivery Driver</h3>
    <a class="card-link" href="/jobs">Explore driving roles</a>
  </article>
  <article class="job-card">
    <h3 class="card-title">Kitchen Crew</h3>
    <a class="card-link" href="/jobs">Explore kitchen roles</a>
  </article>
</section>
<form class="search-form" action="/search">
  <label for="keyword">Keyword</label>
  <input id="keyword" class="search-input" type="text" name="q">
  <input id="location" class="search-input" type="text" name="location">
  <select id="radius" class="search-select" name="radius"><option value="10">10 miles</option></select>
  <button class="search-submit" type="submit">Search</button>
</form>
<div class="carousel">
  <button class="carousel-prev" type="button"><svg width="16" height="16" aria-hidden="true"></svg></button>
  <button class="carousel-dot" type="button"></button>
  <button class="carousel-dot" type="button"></button>
  <button class="carousel-next" type="button"><svg width="16" height="16" aria-hidden="true"></svg></button>
</div>
<div class="jobs-widget" data-react-component="JobList"></div>
<p class="stat">{{ open_roles }}</p>
<p class="stat">Updated daily</p>
</main>
{% endblock %}
