{
  "_doc": "Third-party scripts whose injected DOM is not the site's code. Each entry: id, name, category (cookie-consent|tag-manager|analytics|chat|video|captcha|other), and case-insensitive regex strings in patterns: src (matched against src/href/data-src), id, class (one class token), attr (attribute names), html (the element's opening tag). A node matches when it, or an ancestor on its path to <html>, matches. Extend or override per project with config tracing.vendors (same shape; an entry with an existing id replaces it). Placeholder-free: patterns describe the vendor's public markup, never one site.",
  "vendors": [
    { "id": "google-tag-manager", "name": "Google Tag Manager", "category": "tag-manager",
      "patterns": { "src": ["googletagmanager\\.com"], "html": ["^<script\\b(?=[^>]*\\sid=\"\")(?=[^>]*\\scharset=)"] } },
    { "id": "google-analytics", "name": "Google Analytics", "category": "analytics",
      "patterns": { "src": ["google-analytics\\.com", "/gtag/js"] } },
    { "id": "securiti", "name": "Securiti", "category": "cookie-consent",
      "patterns": { "src": ["securiti\\.ai"], "id": ["^securiti"], "class": ["^cmp-"] } },
    { "id": "cookieconsent", "name": "cookieconsent", "category": "cookie-consent",
      "patterns": { "id": ["^cookieconsent"], "class": ["^cc-(window|banner|btn|link|compliance|grower|revoke|message|highlight|dismiss|invisible|theme-.*)$"] } },
    { "id": "onetrust", "name": "OneTrust", "category": "cookie-consent",
      "patterns": { "src": ["onetrust\\.com", "cookielaw\\.org"], "id": ["^(onetrust|ot-)"], "class": ["^(onetrust|ot-)"] } },
    { "id": "cookiebot", "name": "Cookiebot", "category": "cookie-consent",
      "patterns": { "src": ["cookiebot\\.com"], "id": ["^Cybot"] } },
    { "id": "trustarc", "name": "TrustArc", "category": "cookie-consent",
      "patterns": { "src": ["trustarc\\.com", "truste\\.com"], "id": ["^(truste|teconsent)"] } },
    { "id": "osano", "name": "Osano", "category": "cookie-consent",
      "patterns": { "src": ["osano\\.com"], "class": ["^osano-cm-"] } },
    { "id": "usercentrics", "name": "Usercentrics", "category": "cookie-consent",
      "patterns": { "src": ["usercentrics\\.eu"], "id": ["^usercentrics"] } },
    { "id": "didomi", "name": "Didomi", "category": "cookie-consent",
      "patterns": { "src": ["didomi\\.io"], "id": ["^didomi-"], "class": ["^didomi-"] } },
    { "id": "iubenda", "name": "iubenda", "category": "cookie-consent",
      "patterns": { "src": ["iubenda\\.com"], "id": ["^iubenda"], "class": ["^iubenda-"] } },
    { "id": "termly", "name": "Termly", "category": "cookie-consent",
      "patterns": { "src": ["termly\\.io"], "id": ["^termly"], "class": ["^termly-"] } },
    { "id": "cookieyes", "name": "CookieYes", "category": "cookie-consent",
      "patterns": { "src": ["cookieyes\\.com"], "class": ["^cky-"], "id": ["^cky-"] } },
    { "id": "facebook-pixel", "name": "Meta Pixel", "category": "analytics",
      "patterns": { "src": ["connect\\.facebook\\.net"] } },
    { "id": "linkedin-insight", "name": "LinkedIn Insight Tag", "category": "analytics",
      "patterns": { "src": ["snap\\.licdn\\.com", "px\\.ads\\.linkedin\\.com"] } },
    { "id": "hotjar", "name": "Hotjar", "category": "analytics",
      "patterns": { "src": ["hotjar\\.com"], "id": ["^hotjar", "^_hj"] } },
    { "id": "intercom", "name": "Intercom", "category": "chat",
      "patterns": { "src": ["intercom\\.io", "intercomcdn\\.com"], "id": ["^intercom"], "class": ["^intercom-"] } },
    { "id": "drift", "name": "Drift", "category": "chat",
      "patterns": { "src": ["drift\\.com", "driftt\\.com"], "id": ["^drift-"] } },
    { "id": "hubspot", "name": "HubSpot", "category": "chat",
      "patterns": { "src": ["hubspot\\.com", "hs-scripts\\.com", "hsforms\\.net"], "id": ["^hubspot-messages"] } },
    { "id": "zendesk", "name": "Zendesk", "category": "chat",
      "patterns": { "src": ["zdassets\\.com", "zendesk\\.com"], "id": ["^zendesk", "^ze-snippet"] } },
    { "id": "livechat", "name": "LiveChat", "category": "chat",
      "patterns": { "src": ["livechatinc\\.com"], "id": ["^chat-widget-container$", "^livechat"] } },
    { "id": "youtube", "name": "YouTube", "category": "video",
      "patterns": { "src": ["youtube(-nocookie)?\\.com/(embed|iframe_api)", "youtube\\.com/s/player"], "class": ["^ytp-"] } },
    { "id": "vimeo", "name": "Vimeo", "category": "video",
      "patterns": { "src": ["player\\.vimeo\\.com"] } }
  ]
}
